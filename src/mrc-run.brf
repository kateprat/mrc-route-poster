# MRC ZH running profile: prefers paths, parks and quiet streets. Every traffic light counts as a
# long detour, other street crossings as a shorter one, so loops keep crossing streets to a minimum.

---context:global

assign downhillcost 0
assign downhillcutoff 1.5
assign uphillcost 0
assign uphillcutoff 1.5
assign turnInstructionMode = 0
assign validForFoot 1

assign signalcost   = 400   # %signalcost% | Extra cost (metres) per traffic light | number
assign crossingcost = 120   # %crossingcost% | Extra cost (metres) per street crossing without lights (zebra, unmarked) | number
assign railcost     = 60    # %railcost% | Extra cost (metres) per tram or rail crossing | number

---context:way

assign turncost 0
assign initialclassifier = 0
assign initialcost switch route=ferry 100000 0

assign defaultaccess
       switch access=
              ( if motorroad=yes then false
                else if highway=motorway|motorway_link|trunk|trunk_link then false
                else true )
              switch or access=private access=no false true

assign footaccess
       switch foot=
              defaultaccess
              not or foot=private or foot=no foot=use_sidepath

assign accesspenalty switch footaccess 0 100000

assign costfactor
  add accesspenalty
  switch and highway= not route=ferry 100000
  if      highway=footway|path|pedestrian|track|bridleway|living_street then 1
  else if highway=cycleway                     then 1.1
  else if highway=residential|service          then 1.15
  else if highway=unclassified                 then 1.3
  else if highway=tertiary|tertiary_link       then 1.5
  else if highway=secondary|secondary_link     then 1.8
  else if highway=primary|primary_link         then 2.5
  else if highway=steps                        then 3
  else if highway=proposed|abandoned|construction then 100000
  else 1.5

---context:node

assign defaultaccess
       switch access=
              1
              switch or access=private access=no 0 1

assign footaccess
       switch foot=
              defaultaccess
              switch or foot=private foot=no 0 1

# Crossing a main road where nothing is marked: BRouter's estimate, 1 (quiet) to 6 (busy).
assign maincrossingcost =
       if estimated_crossing_class=1 then 120
       else if estimated_crossing_class=2 then 160
       else if estimated_crossing_class=3 then 200
       else if estimated_crossing_class=4 then 240
       else if estimated_crossing_class=5 then 280
       else if estimated_crossing_class=6 then 320
       else 0

assign crossingpenalty =
       if or highway=traffic_signals crossing=traffic_signals then signalcost
       else if or highway=crossing crossing=zebra|marked|uncontrolled|unmarked|island|yes then crossingcost
       else if railway=level_crossing|crossing then railcost
       else maincrossingcost

assign initialcost
       switch footaccess crossingpenalty 1000000
