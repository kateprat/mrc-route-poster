/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: same-origin
  X-Content-Type-Options: nosniff
/fonts/*
  Cache-Control: public, max-age=2592000
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
