// Cloudflare config: the app in ./site plus a small API (src/worker.js) for the captains' schedule.
// The schedule is stored in a SQLite Durable Object, which Cloudflare creates on deploy.
{
  "name": "mrc-route-poster",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULE", "class_name": "Schedule" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Schedule"] }
  ]
}
